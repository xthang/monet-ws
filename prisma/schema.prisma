  id      String @id @default(cuid()) @db.VarChar(25)
  no      Int    @default(autoincrement())
  orderId String @db.VarChar(50)

  paymentProvider             PaymentProvider
  paymentRequestId            String?         @db.VarChar(50)
  paymentTransactionId        String?         @db.VarChar(50)
  paymentTransactionStatus    String          @db.VarChar(20)
  paymentTransactionMessage   String?         @db.Text
  paymentSource               Json?           @db.Json
  payer                       Json?           @db.Json
  paymentTransactionOtherData Json?           @db.Json

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
