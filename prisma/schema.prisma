model Message {
  // Functional Fields
  id      String  @id @default(cuid()) @db.VarChar(25)
  no      Int     @default(autoincrement())
  uiId    String? @db.VarChar(50)
  groupId String  @db.VarChar(50)
  tabId   String  @db.VarChar(50)

  text          String? @db.Text /// @encrypted // LongText
  moneyRecordId String? @db.VarChar(50)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  // User activities
  sentAt DateTime @db.Timestamptz(3)
  sentBy String   @db.VarChar(50)

  // Foreign Key Relations
  group             Group        @relation(fields: [groupId], references: [id])
  groupTab          GroupTab     @relation(fields: [tabId], references: [id])
  moneyRecord       MoneyRecord?
  sentByAccount     Account      @relation("Message_sentByAccount", fields: [sentBy], references: [id])
  deletedByAccount  Account?     @relation("Message_deletedByAccount", fields: [deletedBy], references: [id])
  group_lastMessage Group?       @relation("lastMessage")

  @@unique([no])
}

model MoneyRecord {
  // Functional Fields
  id                String             @id @default(cuid()) @db.VarChar(25)
  no                Int                @default(autoincrement())
  groupId           String             @db.VarChar(50)
  tabId             String             @db.VarChar(50)
  messageId         String             @db.VarChar(50)
  time              DateTime?          @default(now()) @db.Timestamptz(3)
  type              MoneyRecordType?
  // subType        String?            @db.VarChar(30)
  description       String             @db.Text /// @encrypted // LongText 
  note              String?            @db.Text /// @encrypted // LongText 
  payerMemberId     String             @db.VarChar(50)
  amount            Decimal?
  currency          Currency
  ratePerBase       Boolean?
  rate              Decimal?
  amountPerPartaker Decimal?
  status            MoneyRecordStatus?

  settlementId String? @db.VarChar(50)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  // isTestData Boolean

  // Foreign Key Relations
  group            Group                 @relation(fields: [groupId], references: [id])
  message          Message               @relation(fields: [messageId], references: [id])
  payerMember      GroupMembership       @relation(fields: [payerMemberId], references: [id])
  partakers        MoneyRecordPartaker[]
  expenseDocuments ExpenseDocument[]
  deletedByAccount Account?              @relation("MoneyRecord_deletedByAccount", fields: [deletedBy], references: [id])

  @@unique([no])
  @@unique([messageId])
  @@unique([groupId, messageId])
}

enum MoneyRecordType {
  settlement
}

enum MoneyRecordStatus {
  inactive
}

model MoneyRecordPartaker {
  // Functional Fields
  id            String   @id @default(cuid()) @db.VarChar(25)
  no            Int      @default(autoincrement())
