  no            Int     @default(autoincrement())
  groupId       String  @db.VarChar(50)
  tabId         String  @db.VarChar(50)
  payorMemberId String  @db.VarChar(50)
  payeeMemberId String  @db.VarChar(50)
  amount        Decimal

  settlementRecordId String?   @db.VarChar(50)
  settledAt          DateTime? @db.Timestamptz(3)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
