// common/shared features/functionalities

model Config {
  id    String @id @default(cuid()) @db.VarChar(25)
  key   String
  value Json

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)

  @@unique([key, isActive])
}

model Job {
  // Functional Fields
  id                 String         @id @default(cuid()) @db.VarChar(25)
  no                 Int            @default(autoincrement())
  accountId          String?        @db.VarChar(50)
  orgId              String?        @db.VarChar(50)
  type               JobType
  subType            String?        @db.VarChar(30)
  requestType        String?        @db.VarChar(30)
  requestId          String?        @db.VarChar(50)
  requestData        String         @db.Text
  requestDataVersion String?        @db.VarChar(10)
  resultType         JobResultType?
  resultData         String?        @db.Text // LongText
  resultDataVersion  String?        @db.VarChar(10)
  errorClassname     String?        @db.VarChar(50)
  errorName          String?        @db.VarChar(50)
  errorCode          String?        @db.VarChar(50)
  errorMessage       String?        @db.Text
  errorDetail        String?        @db.Text
  errorStack         String?        @db.Text

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  // isTestData Boolean

  requestedAt DateTime  @db.Timestamptz(3)
  startedAt   DateTime? @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  processTime Float? // @db.Float

  @@unique([no])
}

enum JobType {
  assistantChatRequest
}

enum JobResultType {
  inProgress
  done
  failed
}

model TextTemplate {
  // Functional Fields
  // id       String             @id @default(cuid()) @db.VarChar(25)
  type        TextTemplateType
  key         String             @db.VarChar(200)
  description String?            @db.Text
  version     String             @db.VarChar(20)
  locale      Locale
  content     String             @db.Text
  params      String?            @db.Text
  status      TextTemplateStatus

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  accountId String?   @db.VarChar(50)
  orgId     String?   @db.VarChar(50)

  @@unique([key, version, locale])
}

enum TextTemplateType {
  textContent
}

enum TextTemplateStatus {
  active
  inactive
}

model NotificationTemplate {
  // Functional Fields
  id        String                     @id @default(cuid()) @db.VarChar(25)
  accountId String?                    @db.VarChar(50)
  orgId     String?                    @db.VarChar(50)
  type      NotificationType // provisional
  subType   String?                    @db.VarChar(30)
  key       String                     @db.VarChar(50)
  version   String?                    @db.VarChar(20)
  locale    Locale
  header    String?                    @db.Text
  content   String                     @db.Text
  url       String?                    @db.Text
  status    NotificationTemplateStatus

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  // isTestData Boolean

  @@unique([key, version, locale])
}

enum NotificationTemplateStatus {
  active
  inactive
}

model Notification {
  // Functional Fields
  id              String             @id @default(cuid()) @db.VarChar(25)
  no              Int                @default(autoincrement())
  accountId       String?            @db.VarChar(50)
  orgId           String?            @db.VarChar(50)
  type            NotificationType // provisional
  subType         String?            @db.VarChar(30)
  templateKey     String?            @db.VarChar(50)
  templateVersion String?            @db.VarChar(20)
  templateParams  String?            @db.Text
  header          String?            @db.Text
  content         String?            @db.Text
  dataVersion     String?            @db.VarChar(10)
  data            String?            @db.Text
  status          NotificationStatus
  availableAfter  DateTime?          @db.Timestamptz(3)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  // isTestData Boolean

  // User interactions
  sentAt          DateTime? @db.Timestamptz(3)
  seenAt          DateTime? @db.Timestamptz(3)
  readAt          DateTime? @db.Timestamptz(3)
  markedAsReadAt  DateTime? @db.Timestamptz(3)
  contentViewedAt DateTime? @db.Timestamptz(3)

  @@unique([no])
}

enum NotificationType {
  normal
}

enum NotificationStatus {
  active
  inactive
}

model TaskSendEmail {
  id       Int    @id @default(autoincrement())
  category String
  from     String
  to       Json[]
  cc       Json[]
  bcc      Json[]
  subject  String @db.Text
  text     String @db.Text
  html     String @db.Text

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  jobStartedAt DateTime? @db.Timestamptz(3)
  sentAt       DateTime? @db.Timestamptz(3)
  sentBy       String?   @db.VarChar(50)
  sendResult   Json?
  jobError     String?   @db.Text
}

model TaskSendSms {
  id       Int    @id @default(autoincrement())
  category String
  to       Json[]
  content  String @db.Text

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  jobStartedAt DateTime? @db.Timestamptz(3)
  sentAt       DateTime? @db.Timestamptz(3)
  sentBy       String?   @db.VarChar(50)
  sendResult   Json?
  jobError     String?   @db.Text
}

//

model CurrencyInfo {
  // Functional Fields
  code                Currency @id
  name                String   @db.VarChar(50)
  country             String   @db.VarChar(50)
  imageUrl            String   @db.VarChar(200)
  url                 String   @db.VarChar(200)
  font_Code2000       String   @db.VarChar(30)
  font_arialUnicodeMs String   @db.VarChar(30)
  unicode_decimal     String   @db.VarChar(30)
  unicode_hex         String   @db.VarChar(30)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
}

model CurrencyExchangeRate {
  id String @id @default(cuid()) @db.VarChar(25)
  no Int    @default(autoincrement())

  // Functional Fields
  isDefault Boolean?
  groupId   String?  @db.VarChar(50)
  base      Currency
  to        Currency
  quote     Decimal
  source    String?  @db.VarChar(100)
  order     Int

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)

  group Group? @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([no])
  @@unique([isDefault, base, to, isActive])
  @@unique([groupId, base, to, isActive])
  @@index([isDefault, isActive])
  @@index([groupId, isActive])
}

// Monet's specific features

model Account {
  // Functional Fields
  id            String @id @default(cuid()) @db.VarChar(50)
  no            Int    @default(autoincrement())
  authAccountId String @db.VarChar(50) // Clerk userId

  // Info
  imageUrl   String?    @db.Text
  gender     String?    @db.VarChar(10)
  birthday   DateTime?  @db.Timestamptz(3)
  username   String?    @db.VarChar(100)
  firstName  String?    @db.VarChar(100)
  middleName String?    @db.VarChar(100)
  lastName   String?    @db.VarChar(100)
  nameOrder  NameOrder?
  fullName   String?    @db.VarChar(200)
  nickname   String?    @db.VarChar(100)

  externalId            String? @db.VarChar(50)
  primaryEmailAddressId String? @db.VarChar(50)
  primaryPhoneNumberId  String? @db.VarChar(50)
  primaryWeb3WalletId   String? @db.VarChar(50)

  publicMetadata  Json?
  privateMetadata Json?
  unsafeMetadata  Json?
  otherData       Json?

  role AccountRole @default(user)

  // Security
  password              String?  @db.VarChar(200)
  clerkPasswordEnabled  Boolean?
  clerkTotpEnabled      Boolean?
  clerkTwoFactorEnabled Boolean?

  // User configs
  systemLocale   String?   @db.VarChar(10)
  systemTimezone String?   @db.VarChar(50)
  systemDarkMode String?   @db.VarChar(10)
  locale         Locale?
  darkMode       String?   @db.VarChar(10)
  currency       Currency?
  theme          String?   @db.VarChar(20)

  // Status
  status      AccountStatus?
  clerkBanned Boolean?

  // Subscription
  subscriptionPlan           SubscriptionPlan?
  subscriptionPaymentTransId String?           @db.VarChar(50)
  subscribeAt                DateTime?         @db.Timestamptz(3)
  subscriptionEndedAt        DateTime?         @db.Timestamptz(3)

  // Technical Fields
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  createdBy         String    @db.VarChar(50)
  updatedAt         DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy         String?   @db.VarChar(50)
  deletedAt         DateTime? @db.Timestamptz(3)
  deletedBy         String?   @db.VarChar(50)
  isActive          Boolean?  @default(true)
  // Clerk Technical Fields
  clerkCreatedAt    DateTime  @db.Timestamptz(3)
  clerkUpdatedAt    DateTime? @db.Timestamptz(3)
  clerkLastSignInAt DateTime? @db.Timestamptz(3)
  clerkLastActiveAt DateTime? @db.Timestamptz(3)

  // User activities
  logInCount  Int       @default(0)
  lastLogInAt DateTime? @db.Timestamptz(3)

  // Admin related
  notifiedAt DateTime? @db.Timestamptz(3)

  // Foreign Key Relations
  organizationMemberships  OrganizationMembership[]
  accountAliases           AccountAlias[]
  groupMemberships         GroupMembership[]
  groupAddedMemberships    GroupMembership[]        @relation(name: "addedByAccount")
  groupMembershipRequests  GroupMembershipRequest[]
  messages                 Message[]                @relation(name: "Message_sentByAccount")
  deletedMessages          Message[]                @relation(name: "Message_deletedByAccount")
  deletedMoneyRecords      MoneyRecord[]            @relation(name: "MoneyRecord_deletedByAccount")
  createdExpenseDocuments  ExpenseDocument[]        @relation("ExpenseDocument_createdByAccount")
  uploadedExpenseDocuments ExpenseDocument[]        @relation("ExpenseDocument_uploadedByAccount")
  orders                   Order[]
  subscriptionPaymentTrans PaymentTransaction?      @relation(fields: [subscriptionPaymentTransId], references: [id])

  @@unique([no])
  @@unique([authAccountId])
  @@unique([username, isActive])
  @@unique([subscriptionPaymentTransId])
}

enum NameOrder {
  firstLast
  lastFirst
}

enum AccountRole {
  admin
  moderator
  user
}

enum AccountStatus {
  banned
}

enum SubscriptionPlan {
  advanced
  pro
}

model AccountAlias {
  // Functional Fields
  id                 String           @id @default(cuid()) @db.VarChar(25)
  no                 Int              @default(autoincrement())
  accountId          String?          @db.VarChar(50)
  type               AccountAliasType
  rawValue           String           @db.VarChar(350)
  contactValue       String           @db.VarChar(350)
  valueType          String?          @db.VarChar(20)
  contactGroup       String?          @db.VarChar(50) // for phone no, it is the country calling code
  contactGroupName   String?          @db.VarChar(50) // for phone no, it is the country code
  contactGroup1      String?          @db.VarChar(50) // for phone no, it is the carrier/area code
  contactBody        String?          @db.VarChar(300) // for phone no, it is the main part
  contactExt         String?          @db.VarChar(20) // for phone no, it is the ext code
  formatted          String?          @db.VarChar(350)
  verification       Json?
  verificationStatus String?          @db.VarChar(20)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)
  notified  Int       @default(0) // notify unregistered user about the invitation to a group

  // User activities
  logInCount  Int       @default(0)
  lastLogInAt DateTime? @db.Timestamptz(3)

  // Foreign Key Relations
  account               Account?              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountPartnerAliases AccountPartnerAlias[]
  groupMemberships      GroupMembership[]

  @@unique([no])
  // @@unique([type, contactValue, (CASE WHEN "deletedAt" IS NULL THEN true ELSE NULL END)])
  @@unique([type, contactValue, isActive])
}

enum AccountAliasType {
  emailAddr
  phoneNo
  web3Wallet
  Clerk
}

model AccountPartnerAlias {
  // Functional Fields
  id                    String  @id @default(cuid()) @db.VarChar(50)
  no                    Int     @default(autoincrement())
  accountAliasId        String  @db.VarChar(50)
  partnerId             Partner
  partnerAppId          String? @db.VarChar(50)
  partnerAccountAliasId String  @db.VarChar(50)
  verification          Json?
  verificationStatus    String? @db.VarChar(20)
  otherData             Json?

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)

  // User activities
  logInCount  Int       @default(0)
  lastLogInAt DateTime? @db.Timestamptz(3)

  accountAlias AccountAlias @relation(fields: [accountAliasId], references: [id])

  @@unique([no])
  // @@unique([accountAliasId, partnerId, (CASE WHEN "deletedAt" IS NULL THEN true ELSE NULL END)])
  @@unique([accountAliasId, partnerId, partnerAccountAliasId, isActive])
}

enum Partner {
  Clerk
  Facebook
  AppleID
  GameCenter
  Google
  GooglePlay
  EpicGames
  Tiktok
  Coinbase
  LINE
}

model AccountPlaceholder {
  // Functional Fields
  id   String @id @default(cuid()) @db.VarChar(25)
  no   Int    @default(autoincrement())
  name String @db.Text

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  // Foreign Key Relations
  groupMemberships GroupMembership[]

  @@unique([no])
}

model Organization {
  // Functional Fields
  id String @id @db.VarChar(50)
  no Int    @default(autoincrement())

  // Clerk
  name     String  @db.VarChar(100)
  slug     String? @db.VarChar(100)
  imageUrl String? @db.Text

  publicMetadata  Json?
  privateMetadata Json?

  maxAllowedMemberships Int
  adminDeleteEnabled    Boolean
  membersCount          Int?

  otherData Json?

  // Technical Fields
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdBy      String    @db.VarChar(50)
  updatedAt      DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy      String?   @db.VarChar(50)
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedBy      String?   @db.VarChar(50)
  // Clerk Technical Fields
  clerkCreatedBy String    @db.VarChar(50)
  clerkCreatedAt DateTime  @db.Timestamptz(3)
  clerkUpdatedAt DateTime? @db.Timestamptz(3)

  // Foreign Key Relations
  memberships OrganizationMembership[]

  @@unique([no])
}

model OrganizationMembership {
  // Functional Fields
  id String @id @default(cuid()) @db.VarChar(50)
  no Int    @default(autoincrement())

  // Clerk
  orgId     String                     @db.VarChar(50)
  accountId String                     @db.VarChar(50)
  role      OrganizationMembershipRole

  publicMetadata  Json?
  privateMetadata Json?

  otherData Json?

  // Technical Fields
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  createdBy      String    @db.VarChar(50)
  updatedAt      DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy      String?   @db.VarChar(50)
  deletedAt      DateTime? @db.Timestamptz(3)
  deletedBy      String?   @db.VarChar(50)
  isActive       Boolean?  @default(true)
  // Clerk Technical Fields
  clerkCreatedAt DateTime  @db.Timestamptz(3)
  clerkUpdatedAt DateTime? @db.Timestamptz(3)

  // Foreign Key Relations
  organization Organization @relation(fields: [orgId], references: [id])
  account      Account      @relation(fields: [accountId], references: [id])

  @@unique([no])
  @@unique([orgId, accountId, isActive])
  @@index([orgId])
  @@index([accountId])
}

enum OrganizationMembershipRole {
  admin
  member
  basic_member
  guest_member
}

model Group {
  // Functional Fields
  id           String           @id @default(cuid()) @db.VarChar(25)
  no           Int              @default(autoincrement())
  type         GroupType
  orgId        String?          @db.VarChar(50)
  name         String?          @db.Text /// @encrypted
  description  String?          @db.Text /// @encrypted
  photo        String?          @db.Text
  visibility   GroupVisibility?
  theme        String?          @db.VarChar(20)
  darkMode     String?          @db.VarChar(10)
  emoji        String?          @db.VarChar(20)
  // status    GroupStatus?
  baseCurrency Currency
  note         String?          @db.Text /// @encrypted

  lastActivityAt     DateTime? @db.Timestamptz(3)
  lastTabId          String?   @db.VarChar(50)
  lastMessageId      String?   @db.VarChar(50)
  lastMessageAt      DateTime? @db.Timestamptz(3)
  lastActiveAccounts String?   @db.VarChar(200)

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  // isTestData Boolean

  // Foreign Key Relations
  memberships           GroupMembership[]
  membershipRequests    GroupMembershipRequest[]
  messages              Message[]
  moneyRecords          MoneyRecord[]
  currencyExchangeRates CurrencyExchangeRate[]
  lastMessage           Message?                 @relation("lastMessage", fields: [lastMessageId], references: [id])
  tabs                  GroupTab[]

  @@unique([no])
  @@unique([lastMessageId])
}

enum GroupType {
  direct
  group
}

enum GroupVisibility {
  public
  private
  secret
}

model GroupMembership {
  // Functional Fields
  id                     String           @id @default(cuid()) @db.VarChar(25)
  no                     Int              @default(autoincrement())
  groupId                String           @db.VarChar(50)
  accountId              String?          @db.VarChar(50)
  accountAliasId         String?          @db.VarChar(50)
  accountPlaceholderId   String?          @db.VarChar(50)
  accountOrPlaceholderId String           @db.VarChar(50)
  role                   GroupMemberRole?
  nickname               String?          @db.Text
  addedByAccountId       String           @db.VarChar(50)
  order                  Int

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)

  // user activities
  openTabId String? @db.VarChar(50)

  // Foreign Key Relations
  group                     Group                         @relation(fields: [groupId], references: [id])
  account                   Account?                      @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "GroupMembership_accountOrPlaceholderId_Account_fkey")
  accountAlias              AccountAlias?                 @relation(fields: [accountAliasId], references: [id], onDelete: Restrict, map: "GroupMembership_accountOrPlaceholderId_AccAlias_fkey")
  accountPlaceholder        AccountPlaceholder?           @relation(fields: [accountPlaceholderId], references: [id], onDelete: Restrict, map: "GroupMembership_accountOrPlaceholderId_AccPlhdr_fkey")
  addedByAccount            Account                       @relation(fields: [addedByAccountId], references: [id], name: "addedByAccount")
  moneyRecordPartakers      MoneyRecordPartaker[]
  moneyRecordPayers         MoneyRecord[]
  groupTabSettlements_Payor GroupTabSuggestedSettlement[] @relation(name: "GroupTabSuggestedSettlement_payorMember")
  groupTabSettlements_Payee GroupTabSuggestedSettlement[] @relation(name: "GroupTabSuggestedSettlement_payeeMember")

  @@unique([no])
  @@unique([groupId, accountId, isActive])
  @@unique([groupId, accountAliasId, isActive])
  @@unique([groupId, accountPlaceholderId, isActive])
  @@unique([groupId, accountOrPlaceholderId, isActive])
  // @@unique([groupId, order, isActive])
  @@index([groupId, isActive])
  @@index([accountOrPlaceholderId, isActive])
}

enum GroupMemberRole {
