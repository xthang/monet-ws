enum product_category {
  subscription_plan
}

model product {
  // Technical Fields
  id         String    @id @default(cuid()) @db.VarChar(25)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  created_by String    @db.VarChar(50)
  updated_at DateTime? @updatedAt @db.Timestamptz(3)
  updated_by String?   @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.VarChar(50)

  category    product_category
  code        String           @db.VarChar(100)
  name        Json
  description Json?
  features    Json?
  priority    Int?
  attributes  Json?

  order_items      order_item[]
  product_prices   product_price[]
  product_external product_external[]

  @@unique([code])
}

model product_price {
  // Technical Fields
  id         String    @id @default(cuid()) @db.VarChar(25)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  created_by String    @db.VarChar(50)
  updated_at DateTime? @updatedAt @db.Timestamptz(3)
  updated_by String?   @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.VarChar(50)

  product_id       String    @db.VarChar(25)
  currency         Currency
  listed_price     Decimal
  discount_amount  Decimal?
  discount_percent Decimal?
  price            Decimal
  started_at       DateTime? @db.Timestamptz(3)
  ended_at         DateTime? @db.Timestamptz(3)
  attributes       Json?

  product product @relation(fields: [product_id], references: [id])

  @@index([product_id])
}

enum PaymentProvider {
  // global
  Paypal
  Stripe
  // Vietnam
  NAPAS
  Momo
  VNPAY
  Zalopay
  ViettelMoney
  VNPTMoney
}

model product_external {
  // Technical Fields
  id         String    @id @default(cuid()) @db.VarChar(25)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  created_by String    @db.VarChar(50)
  updated_at DateTime? @updatedAt @db.Timestamptz(3)
  updated_by String?   @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.VarChar(50)

  product_id       String          @db.VarChar(50)
  payment_provider PaymentProvider
  external_id      String          @db.VarChar(50)
  attributes       Json?

  product product @relation(fields: [product_id], references: [id])

  @@unique([product_id, payment_provider])
  @@unique([external_id])
}

model Order {
  id           String  @id @default(cuid()) @db.VarChar(25)
  no           Int     @default(autoincrement())
  accountId    String? @db.VarChar(50)
  orgId        String? @db.VarChar(50)
  currencyCode String  @db.VarChar(5)
  amount       Decimal

  paymentProvider         PaymentProvider
  paymentRequestId        String?         @db.VarChar(50)
  paymentRequestStatus    String?         @db.VarChar(20)
  paymentRequestOtherData Json?           @db.Json

  lastTransactionId String? @unique

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  account              Account?             @relation("Account_Orders", fields: [accountId], references: [id])
  account_subscription Account?             @relation("Account_subscriptionOrders")
  organization         Organization?        @relation(fields: [orgId], references: [id])
  items                order_item[]
  paymentTransactions  PaymentTransaction[]
  lastTransaction      PaymentTransaction?  @relation("Order_lastTransaction", fields: [lastTransactionId], references: [id])

  @@unique([no])
  @@unique([paymentProvider, paymentRequestId])
  @@index([accountId])
  @@index([paymentProvider])
}

model order_item {
  // Technical Fields
  id         String    @id @default(cuid()) @db.VarChar(25)
  created_at DateTime  @default(now()) @db.Timestamptz(3)
  created_by String    @db.VarChar(50)
  updated_at DateTime? @updatedAt @db.Timestamptz(3)
  updated_by String?   @db.VarChar(50)
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.VarChar(50)

  order_id         String   @db.VarChar(25)
  product_id       String   @db.VarChar(25)
  quantity         Int?
  unit_price       Decimal?
  discount_amount  Decimal?
  discount_percent Decimal?
  amount           Decimal?

  order   Order   @relation(fields: [order_id], references: [id])
  product product @relation(fields: [product_id], references: [id])

  @@unique([order_id, product_id])
  @@index([order_id])
}

model PaymentTransaction {
  id      String @id @default(cuid()) @db.VarChar(25)
  no      Int    @default(autoincrement())
  orderId String @db.VarChar(50)

  paymentProvider             PaymentProvider
  paymentRequestId            String?         @db.VarChar(50)
  paymentTransactionId        String?         @db.VarChar(50)
  paymentTransactionStatus    String          @db.VarChar(20)
  paymentTransactionMessage   String?         @db.Text
  paymentSource               Json?           @db.Json
  payer                       Json?           @db.Json
  paymentTransactionOtherData Json?           @db.Json

  // Technical Fields
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  createdBy String    @db.VarChar(50)
  updatedAt DateTime? @updatedAt @db.Timestamptz(3)
  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)

  subscriptionAccount Account?
  order               Order    @relation(fields: [orderId], references: [id])
  order_lastTrans     Order?   @relation("Order_lastTransaction")

  @@unique([no])
  @@unique([paymentProvider, paymentTransactionId])
  @@index([paymentProvider])
}

