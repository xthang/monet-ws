  updatedBy String?   @db.VarChar(50)
  deletedAt DateTime? @db.Timestamptz(3)
  deletedBy String?   @db.VarChar(50)
  isActive  Boolean?  @default(true)

  groupTab    GroupTab        @relation(fields: [tabId], references: [id])
  payorMember GroupMembership @relation(fields: [payorMemberId], references: [id], name: "GroupTabSuggestedSettlement_payorMember")
  payeeMember GroupMembership @relation(fields: [payeeMemberId], references: [id], name: "GroupTabSuggestedSettlement_payeeMember")
  // settlementRecord MoneyRecord?
  // settledRecords   MoneyRecord[]   @relation("MoneyRecord_settledBy")

  @@unique([no])
}

